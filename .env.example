# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_BOOTSTRAP_SECRET: Optional server-side secret to claim or verify first-owner admin access.
# If left empty, the first user can claim admin ownership once via the /admin setup screen.
ADMIN_BOOTSTRAP_SECRET=

# ZX_SESSION_SECRET: Optional secret for signing session tokens (falls back to random key in memory).
ZX_SESSION_SECRET=

# Supabase Configuration (for deploying with external Supabase PostgreSQL + Auth + Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
